{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:palladin:signin:v2",
  "title": "Federated sign-in v2 Discovery",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema",
    "methods"
  ],
  "properties": {
    "schema": {
      "const": "palladin.signin.v2"
    },
    "methods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "provider",
          "entry"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^custom:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$"
          },
          "provider": {
            "enum": [
              "google",
              "apple",
              "microsoft",
              "github",
              "facebook"
            ]
          },
          "entry": {
            "anyOf": [
              {
                "type": "null"
              },
              {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "vaultId",
                  "entryId"
                ],
                "properties": {
                  "vaultId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  },
                  "entryId": {
                    "type": "string",
                    "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                  }
                }
              }
            ]
          }
        }
      },
      "description": "IDs must be unique and strictly increasing by ordinal comparison."
    }
  },
  "$defs": {
    "memberValue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "provider",
        "account",
        "entry"
      ],
      "properties": {
        "provider": {
          "enum": [
            "google",
            "apple",
            "microsoft",
            "github",
            "facebook"
          ]
        },
        "account": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "minLength": 1,
              "maxLength": 256,
              "description": "Must be NFC normalized and trimmed."
            }
          ]
        },
        "entry": {
          "anyOf": [
            {
              "type": "null"
            },
            {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "vaultId",
                "entryId"
              ],
              "properties": {
                "vaultId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                },
                "entryId": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
                }
              }
            }
          ]
        }
      }
    }
  }
}
