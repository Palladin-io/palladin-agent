{
  "name": "@palladin/agent",
  "version": "0.1.0",
  "description": "Script-free launcher for the Palladin native Agent CLI and MCP runtime",
  "author": "Patryk Roguszewski <patryk.roguszewski@palladin.io>",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Palladin-io/palladin-agent.git"
  },
  "homepage": "https://palladin.io",
  "bugs": {
    "url": "https://github.com/Palladin-io/palladin-agent/issues"
  },
  "files": [
    "dist/bin/",
    "dist/runtime/",
    "dist/inject-contract.js",
    "dist/inject-contract.d.ts",
    "dist/form-map.js",
    "dist/form-map.d.ts",
    "README.md",
    "LICENSE",
    "NOTICE",
    "THIRD_PARTY_NOTICES.md",
    "SBOM.cdx.json",
    "SECURITY.md"
  ],
  "workspaces": [
    "packages/*"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "type": "module",
  "exports": {
    "./inject-contract": {
      "types": "./dist/inject-contract.d.ts",
      "import": "./dist/inject-contract.js"
    },
    "./form-map": {
      "types": "./dist/form-map.d.ts",
      "import": "./dist/form-map.js"
    }
  },
  "bin": {
    "palladin": "./dist/bin/palladin.js"
  },
  "scripts": {
    "build": "tsc && npm --prefix packages/playwright-mcp run build && npm --prefix packages/agent-browser-mcp run build",
    "dev": "tsc --watch",
    "start": "node dist/bin/palladin.js",
    "lint": "tsc --noEmit && npm --prefix packages/playwright-mcp run lint && npm --prefix packages/agent-browser-mcp run lint",
    "test": "vitest run && npm run test:release",
    "test:e2e:inject-x": "vite-node tests/e2e/inject-x.ts",
    "plugins:generate": "node plugins/palladin-agent/scripts/generate-targets.mjs",
    "plugins:check": "node plugins/palladin-agent/scripts/generate-targets.mjs --check",
    "verify:form-maps": "PALLADIN_VERIFY_FORM_MAPS=1 vite-node scripts/verify-form-maps.ts",
    "test:release": "node --test packaging/npm/release-scripts.security.mjs",
    "oss:generate": "node packaging/npm/generate-oss-metadata.mjs",
    "oss:check": "node packaging/npm/generate-oss-metadata.mjs --check",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.25.2",
    "@napi-rs/keyring": "^1.3.0",
    "@noble/curves": "^2.2.0",
    "@playwright/mcp": "0.0.79",
    "@types/libsodium-wrappers": "^0.7.14",
    "@types/node": "^26.4.0",
    "agent-browser": "^0.33.2",
    "commander": "^13.1.0",
    "libsodium-wrappers": "^0.8.4",
    "linkedom": "^0.18.13",
    "playwright": "1.63.0-alpha-2026-08-05",
    "tldts": "^7.4.10",
    "typescript": "^5.8.0",
    "vite-node": "^6.0.0",
    "vitest": "^4.1.10",
    "zod": "4.4.3"
  },
  "engines": {
    "node": ">=20.5.0",
    "npm": ">=9.7.1"
  },
  "overrides": {
    "nanoid": "3.3.18",
    "postcss": "8.5.26"
  },
  "optionalDependencies": {
    "@palladin/runtime-darwin-arm64": "0.1.0",
    "@palladin/runtime-darwin-x64": "0.1.0",
    "@palladin/runtime-linux-arm64-gnu": "0.1.0",
    "@palladin/runtime-linux-arm64-musl": "0.1.0",
    "@palladin/runtime-linux-x64-gnu": "0.1.0",
    "@palladin/runtime-linux-x64-musl": "0.1.0",
    "@palladin/runtime-win32-arm64": "0.1.0",
    "@palladin/runtime-win32-x64": "0.1.0"
  }
}
