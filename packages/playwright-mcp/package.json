{
  "name": "@palladin/playwright-mcp",
  "version": "0.1.0",
  "description": "Playwright MCP provider for value-free Palladin credential Inject",
  "private": true,
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Palladin-io/palladin-agent.git",
    "directory": "packages/playwright-mcp"
  },
  "type": "module",
  "bin": {
